[general]
dir = /usr/local/bin
serial = 1114533950505869

[security]
encryption_key = diamondback.key
username = sysadmin
password = 7qogP4xljqTVg+zIGsUAg1DltfXT3l2Df5igfM3VVHzdzwUrSt/kGl4iRbDwH/c/WAG+3D4C

[database]
type = sqlite
url = diamondback.sqlite

[api]
status = /api/system/ping

[execution]
wait = 30
speak = false
ignore = 10.0.0.1,10.0.10.1

[server]
last = 192.168.1.1
username = sysadmin

[piper]
home = ./data
voice = en_US-amy-medium.onnx

[loggers]
keys = root,my_app

[logger_root]
level = DEBUG
handlers = console

[logger_my_app]
level = DEBUG
handlers = file_handler,console
qualname = diamondback
propagate = 0

[handlers]
keys = console,file_handler

[handler_console]
class = StreamHandler
level = INFO
formatter = detailed_formatter
args = (sys.stdout,)

[handler_file_handler]
class = handlers.RotatingFileHandler
level = DEBUG
formatter = detailed_formatter
args = ('diamondback.log', 'a', 10485760, 5)

[formatters]
keys = simple_formatter,detailed_formatter

[formatter_simple_formatter]
format = %(levelname)s: %(message)s

[formatter_detailed_formatter]
format = %(asctime)s - [%(module)s:%(levelname)s] [%(filename)s:%(lineno)d] - %(message)s
datefmt = %Y-%m-%d %H:%M:%S

