{
    "name" : "multi_write_test",
    "serial": 11248585048,
    "actions": [
        { "name":"ICMPScan", "timeout":5, "update_host":true, "skip": false },

        {
            "name": "hit_each",
            "loop": true,
            "target": "host",
            "workswith": "windows",
            "actions": [
                { "name":"FileSystemWrite", "connection":"smb", "remote_file":"c:\\temp\\this_is_malware.txt", "local_file":"/tmp/test.txt"}
            ]
        },
        {
            "name": "hit_each",
            "loop": true,
            "target": "host",
            "workswith": "linux",
            "override_user": "sysadmin",
            "actions": [
                { "name":"FileSystemWrite", "connection":"ssh", "remote_file":"/tmp/this_is_malware", "local_file":"/tmp/test.txt"}
            ]
        }        
    ]
}